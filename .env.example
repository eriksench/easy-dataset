# Easy Dataset local database
DATABASE_URL="file:./db.sqlite"
LOCAL_DB_PATH="./local-db"

# Know Hub department-file integration
KNOW_HUB_BASE_URL="http://localhost:8085/jeecg-boot"
# Browser-visible Know-Hub frontend URL used when a direct Easy Dataset visit needs Key login.
KNOW_HUB_PUBLIC_URL="http://localhost:3100"
KNOW_HUB_SSO_ENABLED="true"
# Must match Know Hub's integration.depart-file-token / INTEGRATION_DEPART_FILE_TOKEN when configured.
KNOW_HUB_INTEGRATION_TOKEN=""
# At least 32 random characters; used to encrypt the HttpOnly Easy Dataset session cookie.
EASY_DATASET_SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
